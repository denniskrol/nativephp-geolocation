{
  "name": "denniskrol/nativephp-geolocation",
  "display_name": "NativePHP Geolocation",
  "namespace": "Geolocation",

  "bridge_functions":  [
    {
      "name": "Geolocation.GetCurrentPosition",
      "android": "com.denniskrol.nativephpgeolocation.GeolocationPlugin.GetCurrentPosition",
      "android_params": ["context"],
      "ios": "GeolocationPlugin.GetCurrentPosition"
    },
    {
      "name": "Geolocation.RequestPermission",
      "android": "com.denniskrol.nativephpgeolocation.GeolocationPlugin.RequestPermission",
      "ios": "GeolocationPlugin.RequestPermission"
    },
    {
      "name": "Geolocation.GetBackgroundPosition",
      "android": "com.denniskrol.nativephpgeolocation.GeolocationPlugin.GetBackgroundPosition",
      "android_params": ["context"]
    },
    {
      "name": "Geolocation.HasBackgroundPermission",
      "android": "com.denniskrol.nativephpgeolocation.GeolocationPlugin.HasBackgroundPermission",
      "android_params": ["context"]
    },
    {
      "name": "Geolocation.RequestBackgroundPermission",
      "android": "com.denniskrol.nativephpgeolocation.GeolocationPlugin.RequestBackgroundPermission"
    }
  ],
   "android": {
    "min_version": 33,
    "permissions": [
      "android.permission.ACCESS_COARSE_LOCATION",
      "android.permission.ACCESS_FINE_LOCATION",
      "android.permission.ACCESS_BACKGROUND_LOCATION"
    ],
    "dependencies": {
      "implementation": [
        "com.google.android.gms:play-services-location:21.3.0"
      ]
    }
  },
  "ios": {
    "min_version": "18.2",
    "info_plist": {
      "NSLocationWhenInUseUsageDescription": "This app uses your location to show your current position."
    }
  }
}
