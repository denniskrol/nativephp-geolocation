{
  "name": "denniskrol/nativephp-geolocation",
  "description": "Custom geolocation plugin for NativePHP Mobile",
  "type": "nativephp-plugin",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Denniskrol\\NativePHPGeolocation\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Denniskrol\\NativePHPGeolocation\\NativePHPGeolocationServiceProvider"
      ]
    },
    "nativephp": {
      "manifest": "nativephp.json"
    }
  },
  "require": {
    "php": "^8.4",
    "nativephp/mobile": "^4.2"
  }
}
